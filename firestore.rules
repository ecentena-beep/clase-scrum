rules_version = '2';

// Reglas de seguridad de la clase de Scrum.
// Pegalas en Firebase → Firestore Database → Reglas → Publicar (README, paso 2).
service cloud.firestore {
  match /databases/{database}/documents {

    match /salas/{sala} {
      function logueado() { return request.auth != null; }
      function datosSala() { return get(/databases/$(database)/documents/salas/$(sala)).data; }
      function esDocente() { return logueado() && datosSala().docenteUid == request.auth.uid; }

      // La clase: cualquiera con sesión la lee; solo quien la creó la modifica.
      allow read: if logueado();
      allow create: if logueado() && request.resource.data.docenteUid == request.auth.uid;
      allow update, delete: if logueado() && resource.data.docenteUid == request.auth.uid;

      // Personas conectadas: cada uno escribe solo su propio registro.
      match /participantes/{uid} {
        allow read: if logueado();
        allow create, update: if logueado() && request.auth.uid == uid
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
          && request.resource.data.apellido is string && request.resource.data.apellido.size() <= 40
          && request.resource.data.cuenta is string && request.resource.data.cuenta.size() <= 80;
        allow delete: if logueado() && (request.auth.uid == uid || esDocente());
      }

      // Tablero de cada equipo: lo editan sus integrantes y el docente.
      match /grupos/{gid} {
        allow read: if logueado();
        allow create, update: if logueado()
          && (esDocente() || request.auth.uid in datosSala().equipos[gid].miembros)
          && request.resource.data.keys().hasOnly(['orden', 'talles', 'elegidas', 'objetivo']);
        allow delete: if esDocente();
      }

      // Cuestionario: cada uno escribe solo sus respuestas; todos ven los resultados.
      match /quiz/{uid} {
        allow read: if logueado();
        allow create, update: if logueado() && request.auth.uid == uid;
        allow delete: if esDocente();
      }
    }
  }
}
